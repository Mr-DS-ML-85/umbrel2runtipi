{
  "$schema": "../app-info-schema.json",
  "name": "MailFlow",
  "available": true,
  "exposable": true,
  "dynamic_config": true,
  "port": 3395,
  "id": "mailflow",
  "tipi_version": 1,
  "version": "latest",
  "categories": [
    "network"
  ],
  "description": "MailFlow is a self-hosted unified webmail client. Connect multiple IMAP/SMTP accounts such as Gmail, iCloud, Outlook, or custom mail servers and read them in one web interface.\n\nIt includes a unified inbox, search, compose/reply/forward, folder navigation, multiple themes, user management, SSO/OIDC support, and Microsoft 365 OAuth2 support.",
  "short_desc": "Unified self-hosted webmail client",
  "author": "maathimself",
  "source": "https://github.com/maathimself/mailflow",
  "website": "https://mailflow.sh",
  "form_fields": [
    {
      "label": "Session secret",
      "type": "random",
      "env_variable": "SESSION_SECRET",
      "min": 32,
      "required": false,
      "hint": "Must be at least 32 characters."
    },
    {
      "label": "Encryption key",
      "type": "random",
      "env_variable": "ENCRYPTION_KEY",
      "encoding": "hex",
      "min": 64,
      "required": false,
      "hint": "Exactly 64 hex characters (32 bytes)."
    }
  ],
  "supported_architectures": [
    "arm64",
    "amd64"
  ],
  "created_at": 1786720647466,
  "updated_at": 1786720647466,
  "min_tipi_version": "4.5.0"
}
